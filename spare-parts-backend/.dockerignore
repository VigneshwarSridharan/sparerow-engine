# Dependencies & caches
node_modules
npm-debug.log*

# Build outputs (rebuilt in image or on develop)
dist
build
.cache
.strapi
.tsbuildinfo

# Local data & secrets
.tmp
.env
.env.*
!.env.docker.example
# Uploaded media is per-environment, never bake the local dev machine's
# uploads into the image (a redeploy would otherwise overwrite prod's
# uploaded files with whatever happens to be on the builder's disk).
public/uploads

# Git & IDE
.git
.gitignore
.idea
.vscode

# Tests & docs (not needed to run Strapi)
coverage
*.md
!README.md
docs
