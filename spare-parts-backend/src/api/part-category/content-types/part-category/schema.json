{
  "kind": "collectionType",
  "collectionName": "part_categories",
  "info": {
    "singularName": "part-category",
    "pluralName": "part-categories",
    "displayName": "Part Category"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "partCategory"
    }
  }
}
