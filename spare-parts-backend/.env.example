# Strapi core
HOST=0.0.0.0
PORT=1337
APP_KEYS="change-me-1,change-me-2"
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# Database: set DATABASE_CLIENT=postgres and DATABASE_URL for production
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://strapi:strapi@localhost:5432/strapi_spare
# Local dev without Postgres: DATABASE_CLIENT=sqlite

# Server-to-server + admin API protection
STRAPI_INTERNAL_API_KEY=change-me-long-random

# Storefront customer JWT (separate from Users & Permissions JWT_SECRET)
CUSTOMER_JWT_SECRET=change-me-customer-jwt

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shipping
SHIPPING_PRIMARY_CARRIER=MOCK
SHIPPING_ENABLE_LIVE=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_WEBHOOK_SECRET=
DELHIVERY_API_TOKEN=
DELHIVERY_PICKUP_WAREHOUSE=
SHIPPING_DEFAULT_WEIGHT_GRAMS=500
SHIPPING_ORIGIN_NAME=Warehouse
SHIPPING_ORIGIN_PHONE=9876543210
SHIPPING_ORIGIN_LINE1=Industrial Area Phase 1
SHIPPING_ORIGIN_CITY=Bengaluru
SHIPPING_ORIGIN_POSTAL_CODE=560001
SHIPPING_ORIGIN_STATE=KA

# Email (Resend)
EMAIL_FROM=orders@sparehub.com
RESEND_API_KEY=
