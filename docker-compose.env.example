# Copy to `.env` in the repository root so Docker Compose picks up defaults.
# (This file is only for Compose — keep app secrets in spare-parts-backend/.env.)

# Default: development stack (Strapi + storefront). Add `,with-postgres` when using the with-postgres profile.
COMPOSE_PROFILES=dev

# Optional overrides (examples):
# STOREFRONT_PORT=8080
# STRAPI_PORT=1337
# VITE_STOREFRONT_GRAPHQL_ENDPOINT=http://localhost:1337/graphql
