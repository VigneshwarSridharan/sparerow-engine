# Optional: copy to `.env` for local overrides when not using Compose `environment:`.
# GraphQL URL must be reachable from the **browser** (not from inside the storefront container).
# Default when using published ports: Strapi on host 1337 → use localhost.
VITE_STOREFRONT_GRAPHQL_ENDPOINT=http://localhost:1337/graphql

# Error tracking (Sentry) — leave blank to disable
VITE_SENTRY_DSN=

# Product analytics / funnel tracking (PostHog) — leave blank to disable
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
