# Sparerow Engine — Production Environment
# Copy this to .env and fill in actual values

# Domain & SSL (Let's Encrypt)
LETSENCRYPT_DOMAIN=yourdomain.com
LETSENCRYPT_EMAIL=admin@yourdomain.com

# Database
POSTGRES_USER=strapi
POSTGRES_PASSWORD=change_this_to_secure_password
POSTGRES_DB=strapi_spare

# Storefront
# Use relative path so frontend makes requests to same domain
VITE_STOREFRONT_GRAPHQL_ENDPOINT=/graphql

# Optional: exposing backend port for debugging (remove in final production)
# STRAPI_PORT=1337
